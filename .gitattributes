# Applied with "git apply" to sources that use LF line endings, and run by
# bash: these must not be converted to CRLF on Windows checkouts.
Delta.Wsq/nbis/patches/*.patch  -text
Delta.Wsq/nbis/nbis-source.env  text eol=lf
*.sh                            text eol=lf
Delta.Wsq/nbis/lib*/SOURCE      text eol=lf
